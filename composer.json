{
    "name": "sarojsardar/laravel-nepali-date",
    "description": "Laravel Nepali Date Converter Package",
    "type": "library",
    "keywords": ["laravel", "nepali", "date", "converter", "bikram", "sambat"],
    "license": "MIT",
    "authors": [
        {
            "name": "Saroj Sardar",
            "email": "sarojsardar25@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SarojSardar\\LaravelNepaliDate\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SarojSardar\\LaravelNepaliDate\\NepaliDateServiceProvider"
            ],
            "aliases": {
                "NepaliDate": "SarojSardar\\LaravelNepaliDate\\Facades\\NepaliDate"
            }
        }
    },
    "minimum-stability": "stable"
}